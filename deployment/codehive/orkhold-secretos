#!/usr/bin/env bash
# Secretos del despliegue de Orkhold en codehive. Ningún valor se imprime ni pasa por la línea de órdenes.
# Se instala como /home/codehive/bin/orkhold-secretos (enlace a este fichero).
#   orkhold-secretos generar   crea .env con valores al azar si no existe (primer despliegue)
#   orkhold-secretos guardar   guarda los valores de .env en la bóveda (necesita vault-desbloquear)
#   orkhold-secretos escribir  vuelve a escribir .env desde la bóveda
# Entradas de la bóveda: "juego - postgres", "juego - api secreto", "juego - clave servidor mundo" y, si está,
# "ionos mail orkhold" (correo no-responder@orkhold.com para las cuentas).
set -euo pipefail
export PATH="/home/codehive/bin:/home/codehive/.local/bin:$PATH"
export NODE_OPTIONS="${NODE_OPTIONS:---no-deprecation}"
DIR=/home/codehive/codehive-app-state/deployments/orkhold
ENV="$DIR/workspace/deployment/.env"
URL=https://app.orkhold.com
NOMBRES=("POSTGRES_PASSWORD|juego - postgres|orkhold" "API_SECRETO|juego - api secreto|api" "CLAVE_SERVIDOR|juego - clave servidor mundo|mundo")

fijos() {
  cat <<'FIN'
PUERTO_API=4152
PUERTO_MUNDO=7777
MUNDO_DOCKERFILE=Dockerfile.wine
MUNDO_ESTADO=Z:\estado\mundo.json
DIR_ESTADO=/home/codehive/codehive-app-state/deployments/orkhold/estado
FIN
}

valor() { grep "^$1=" "$ENV" | head -1 | cut -d= -f2-; }

case "${1:-}" in
  generar)
    if [ -f "$ENV" ]; then echo "Ya existe $ENV; no se toca."; exit 0; fi
    umask 077
    { for n in "${NOMBRES[@]}"; do printf '%s=%s\n' "${n%%|*}" "$(openssl rand -hex 24)"; done; fijos; } > "$ENV"
    chmod 600 "$ENV"
    echo "Escrito $ENV con valores nuevos. Guárdalos con: orkhold-secretos guardar"
    ;;
  guardar)
    for n in "${NOMBRES[@]}"; do
      IFS='|' read -r var nombre usuario <<< "$n"
      valor "$var" | vault-guardar "$nombre" --usuario "$usuario" --url "$URL" >/dev/null
      echo "Guardado en la bóveda: $nombre"
    done
    ;;
  escribir)
    FICHERO_SESION="/dev/shm/vault-session-$(id -u)"
    [ -f "$FICHERO_SESION" ] || { echo "La bóveda está bloqueada. Ejecuta: vault-desbloquear" >&2; exit 1; }
    export BW_SESSION=$(tail -n1 "$FICHERO_SESION")
    umask 077
    TMP=$(mktemp -p /dev/shm)
    trap 'shred -u "$TMP" 2>/dev/null || rm -f "$TMP"' EXIT
    for n in "${NOMBRES[@]}"; do
      IFS='|' read -r var nombre usuario <<< "$n"
      v=$(bw get password "$nombre" 2>/dev/null) || { echo "No existe \"$nombre\" en la bóveda" >&2; exit 1; }
      printf '%s=%s\n' "$var" "$v" >> "$TMP"
    done
    fijos >> "$TMP"
    # Correo de las cuentas (14-cuentas.md §3): buzón de IONOS, si está en la bóveda.
    if c=$(bw get password "ionos mail orkhold" 2>/dev/null); then
      CLAVE_SMTP="$c" python3 -c 'import os,urllib.parse as u; print("SMTP_URL=smtps://"+u.quote("no-responder@orkhold.com",safe="")+":"+u.quote(os.environ["CLAVE_SMTP"],safe="")+"@smtp.ionos.es:465")' >> "$TMP"
      echo 'CORREO_REMITENTE=Orkhold <no-responder@orkhold.com>' >> "$TMP"
    fi
    mv "$TMP" "$ENV"; trap - EXIT; chmod 600 "$ENV"
    echo "Escrito $ENV desde la bóveda. Ningún valor se ha mostrado."
    ;;
  *) echo "Uso: orkhold-secretos generar|guardar|escribir" >&2; exit 2 ;;
esac
