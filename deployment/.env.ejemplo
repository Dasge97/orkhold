# Copiar a .env en el servidor y rellenar desde la bóveda. .env no va en git.
POSTGRES_PASSWORD=
API_SECRETO=
CLAVE_SERVIDOR=
PUERTO_API=4152
# Correo de las cuentas (opcional): smtps://usuario:clave@servidor:465. La clave, en la bóveda.
SMTP_URL=
CORREO_REMITENTE=Orkhold <no-responder@orkhold.com>
PUERTO_MUNDO=7777
# Servidor de mundo: Dockerfile (Linux) o Dockerfile.wine (ejecutable de Windows con Wine)
MUNDO_DOCKERFILE=Dockerfile
MUNDO_ESTADO=/estado/mundo.json
# Con Wine: MUNDO_ESTADO=Z:\estado\mundo.json
DIR_ESTADO=./estado
